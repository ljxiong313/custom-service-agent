# =============================================================================
# 每店一份的环境变量文件（配合 deploy/shop.example.yaml 里的 ${VAR} 占位符）
# -----------------------------------------------------------------------------
# 放置与权限：
#   sudo cp deploy/env.shop.example /etc/cs-agent/shop-a.env
#   sudo chmod 600 /etc/cs-agent/shop-a.env        # 里面有口令，别的账号读不到才对
#
# 三种用法都读它：
#   docker compose → environment_file: /etc/cs-agent/shop-a.env（见 docker-compose.shop.yml）
#   systemd        → EnvironmentFile=/etc/cs-agent/shop-%i.env（见 cs-agent@.service）
#   手动跑         → set -a; . /etc/cs-agent/shop-a.env; set +a; python run.py
#
# 规则：本文件只放密钥与每店不同的值，行为参数留在 YAML 里。
# 不要把任何一个 *_SECRET / *_PASSWORD / *_TOKEN 写进 deploy/shop.example.yaml，
# 那份文件是要进 git 的（它没有密钥，所以可以）。
# 也不要在这个文件里写 `export` —— systemd 的 EnvironmentFile 不认，它只要 KEY=VALUE。
# =============================================================================

# ---------- 数据库：一店一库 ----------
# 库名只在本文件出现，YAML 里是 ${CS_DB_NAME}。忘配的话连的是
# postgresql+…/SET_CS_DB_NAME_PER_SHOP 这个不存在的库，启动即失败——这是故意的，
# 比"悄悄连到隔壁店的库"好得多。
CS_DB_HOST=127.0.0.1
CS_DB_PORT=5432
CS_DB_USER=cs_agent
CS_DB_PASSWORD=换成该库角色的口令
CS_DB_NAME=cs_shop_a

# ---------- 对外地址与端口（每店不同）----------
# 同机多实例时这个端口必须逐店不同（systemd 模板拼不出端口号，只能写在这里）；
# compose 形态下容器内部恒为 7861，改的是宿主侧的 ports 映射，这里留空即可。
CS_SERVER_PORT=7861
# 买家在平台客户端里点开的附件链接、满意度回访链接都用它拼绝对地址。
# 有平台真实外呼却没配它 → 生产直接拒绝启动（app/startup_check.py）。末尾不带 /。
CS_PUBLIC_BASE_URL=https://cs-a.example.com

# ---------- 密钥 ----------
# 每店独立生成，别在店之间复用：一个泄漏不会连带其他店。
#   openssl rand -hex 32
CS_JWT_SECRET=
# 可选：附件签名 URL 单独一把钥匙（留空回落 jwt_secret）。轮换它只让旧附件链接失效，不影响登录。
CS_MEDIA_URL_SECRET=
# 可选：满意度回访链接的签名钥匙（留空回落 jwt_secret）。
CS_FEEDBACK_SECRET=
# /metrics 的访问令牌。留空 = 生产环境直接 403（不配就不暴露内部指标）。
CS_METRICS_TOKEN=

# ---------- 模型 ----------
CS_MODEL_API_KEY=
# 备用供应商（llm.fallback 里填它的名字才生效）。多店共用一家时强烈建议配上：
# 否则一家限流，所有店同时哑掉。
CS_BACKUP_API_KEY=

# ---------- 向量索引目录（容器部署留空即可，走各自挂载的 /app/data）----------
CS_CHROMA_PATH=
CS_BM25_PATH=

# ---------- 企业微信转人工 ----------
CS_WECOM_CORP_ID=
CS_WECOM_CORP_SECRET=
CS_WECOM_AGENT_ID=
CS_WECOM_CALLBACK_TOKEN=
CS_WECOM_AES_KEY=                                  # 43 位

# ---------- 电商平台（一店一套授权，token 是按店铺给的）----------
CS_TAOBAO_APP_KEY=
CS_TAOBAO_APP_SECRET=
CS_TAOBAO_ACCESS_TOKEN=
CS_JD_APP_KEY=
CS_JD_APP_SECRET=
CS_JD_ACCESS_TOKEN=
CS_PDD_APP_KEY=
CS_PDD_APP_SECRET=
CS_PDD_ACCESS_TOKEN=
CS_DOUYIN_APP_KEY=
CS_DOUYIN_APP_SECRET=
CS_DOUYIN_ACCESS_TOKEN=

# ---------- 备份 ----------
# scripts/backup_data.py --out 用；每店各一份快照目录，别混在一个目录里（轮转按目录算份数）
CS_BACKUP_OUT=/var/backups/cs-agent/shop-a
CS_BACKUP_KEEP=14
