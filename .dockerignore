*.pyc
.git/
.gitignore
.mypy_cache/
.pytest_cache/
.ruff_cache/

src/backend/config.local.yaml
src/backend/data/
src/backend/uvicorn_dev.log

src/frontend/
docs/
eval/
pyproject.toml
README.md
Dockerfile
.dockerignore
docker-compose.yml
